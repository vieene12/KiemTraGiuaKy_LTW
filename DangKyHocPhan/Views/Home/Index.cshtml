@model DangKyHocPhan.Models.CourseListViewModel

@{
    ViewData["Title"] = "Trang Chủ - Danh Sách Học Phần";
    bool isStudent = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("STUDENT");
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark mb-2">DANH SÁCH HỌC PHẦN</h1>
        <div class="mx-auto bg-primary mb-3" style="width: 60px; height: 3px;"></div>
        <p class="lead text-muted col-md-8 mx-auto">Tìm kiếm và đăng ký các khóa học chất lượng trong học kỳ của bạn.</p>
    </div>

    <!-- Thanh tìm kiếm phẳng -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-6 col-lg-5">
            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex bg-white border border-secondary shadow-sm">
                <span class="d-flex align-items-center ps-3 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control border-0 bg-transparent py-2 ps-2" placeholder="Tìm tên học phần..." aria-label="Tìm kiếm" style="box-shadow: none;" />
                @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light d-flex align-items-center border-0 px-3 bg-transparent text-muted" title="Xóa tìm kiếm">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary border-0 px-4 py-2">Tìm kiếm</button>
            </form>
        </div>
    </div>

    <!-- Course Grid -->
    @if (Model.Courses != null && Model.Courses.Any())
    {
        var enrolledIds = ViewBag.EnrolledCourseIds as List<int> ?? new List<int>();
        <div class="row">
            @foreach (var course in Model.Courses)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 border shadow-sm">
                        <!-- Ảnh Học Phần -->
                        <div class="position-relative" style="height: 180px; overflow: hidden; background-color: #f8fafc;">
                            <img src="@(string.IsNullOrEmpty(course.Image) ? "" : course.Image)" 
                                 alt="@course.Name"
                                 class="w-100 h-100"
                                 style="object-fit: cover;"
                                 onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100%\' height=\'100%\' viewBox=\'0 0 300 180\'><rect width=\'100%\' height=\'100%\' fill=\'%23f1f5f9\'/><text x=\'50%\' y=\'55%\' font-size=\'14\' font-weight=\'bold\' text-anchor=\'middle\' fill=\'%2394a3b8\'>@course.Name</text></svg>';" />
                            <!-- Badge danh mục -->
                            <span class="position-absolute top-0 end-0 m-3 badge bg-primary-light">
                                @(course.Category?.Name ?? "N/A")
                            </span>
                        </div>
                        <!-- Nội dung thẻ -->
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@course.Name</h5>
                            <p class="text-muted small mb-3">
                                Giảng viên: <strong class="text-dark">@course.Lecturer</strong>
                            </p>
                            
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="text-secondary fw-semibold">
                                    <span class="badge bg-slate-light font-monospace me-1 text-dark">@course.Credits</span> Tín chỉ
                                </span>
                                @if (isStudent)
                                {
                                    @if (enrolledIds.Contains(course.Id))
                                    {
                                        <form asp-controller="Enroll" asp-action="UnenrollCourse" asp-route-courseId="@course.Id" method="post" class="mb-0">
                                            <button type="submit" class="btn btn-sm btn-danger px-3 fw-bold">
                                                <i class="bi bi-dash-square me-1"></i> Hủy Đăng Ký
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Enroll" asp-action="EnrollCourse" asp-route-courseId="@course.Id" method="post" class="mb-0">
                                            <button type="submit" class="btn btn-sm btn-success px-3 fw-bold">
                                                <i class="bi bi-plus-square me-1"></i> Đăng Ký
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white border shadow-sm">
            <div class="text-muted mb-3">
                <i class="bi bi-journal-x fs-1"></i>
            </div>
            <h4 class="text-muted fw-bold">Không tìm thấy học phần nào</h4>
            <p class="text-muted mb-0">Vui lòng thử lại với từ khóa khác.</p>
        </div>
    }

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <!-- Nút trang trước -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link d-flex align-items-center" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, searchString = ViewBag.CurrentFilter })" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                <!-- Danh sách số trang -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.CurrentFilter })">@i</a>
                    </li>
                }

                <!-- Nút trang sau -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link d-flex align-items-center" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, searchString = ViewBag.CurrentFilter })" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
