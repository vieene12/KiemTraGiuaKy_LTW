@model IEnumerable<DangKyHocPhan.Models.Course>

@{
    ViewData["Title"] = "Quản Lý Học Phần";
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
        <div>
            <h1 class="display-5 fw-bold text-dark mb-1">QUẢN LÝ HỌC PHẦN</h1>
            <p class="lead text-muted mb-0">Hệ thống quản lý dành riêng cho Quản trị viên (ADMIN)</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold d-flex align-items-center">
                <i class="bi bi-plus-lg me-2"></i> Thêm Học Phần Mới
            </a>
        </div>
    </div>

    <!-- Flat Table Container -->
    <div class="table-container shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col" style="width: 100px;">Hình ảnh</th>
                        <th scope="col">Tên Học Phần</th>
                        <th scope="col">Số Tín Chỉ</th>
                        <th scope="col">Giảng Viên</th>
                        <th scope="col">Danh Mục</th>
                        <th scope="col" class="text-center" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.Image) ? "" : item.Image)" 
                                         alt="@item.Name"
                                         class="img-thumbnail"
                                         style="width: 60px; height: 60px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'60\' height=\'60\' viewBox=\'0 0 60 60\'><rect width=\'60\' height=\'60\' fill=\'%23f1f5f9\'/><text x=\'50%\' y=\'55%\' font-size=\'8\' text-anchor=\'middle\' fill=\'%2394a3b8\'>No Image</text></svg>';" />
                                </td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td>
                                    <span class="badge bg-slate-light text-dark font-monospace">@item.Credits</span> tín chỉ
                                </td>
                                <td>@item.Lecturer</td>
                                <td>
                                    <span class="badge bg-primary-light">@(item.Category?.Name ?? "N/A")</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary fw-bold px-3">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger fw-bold px-3">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted bg-white">
                                <div class="mb-3">
                                    <i class="bi bi-journal-plus fs-2 text-muted"></i>
                                </div>
                                <p class="mb-3">Không tìm thấy học phần nào trong hệ thống.</p>
                                <a asp-action="Create" class="btn btn-primary btn-sm fw-bold">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm học phần đầu tiên
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
