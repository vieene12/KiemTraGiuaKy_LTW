## Ignore Visual Studio temporary files, build results, and
## user-specific files.

# User-specific files
*.rsuser
*.suo
*.user
*.useros
*.sln.docstates

# User-specific files (MonoDevelop/ActiveState ActiveGoDB)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Ff]xCop/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/

# MSTest test Results
[T]est[R]esult*/
[B]uild[L]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Office Extension files
-built.js
-built.css

# ReSharper is a code analysis tool for .NET
_ReSharper*/
*.[Re]Sharper
*.DotSettings.user

# DotCover is a Code Coverage Tool
*.cov

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Auto-created backup folders
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence Projects
*.rdl.data
*.sbdf
*.suo.web
*.userprofile

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# WebMatrixTemplate
*.webmatrix

# RIDER
.idea/

# Visual Studio Code
.vscode/

# Local History for Visual Studio Code
.history/

# Windows image analyses cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini
